# Looker API 4.0 credentials for scripts/looker_fetch.py
# Copy this file to  credentials/looker.env  and fill it in. (looker.env is gitignored.)
#
# Generate an API3 key in Looker:  Admin -> Users -> (your user) -> Edit Keys -> New API3 Key.
# The credential's user needs to: see models, see dashboards, and run queries.
# (Pulling raw LookML over the API additionally needs the "develop" permission; if the
#  user lacks it, clone the LookML Git repo instead and point the skill at the files.)
#
# Alternatively, use the Looker SDK's standard ~/.looker/looker.ini [Looker] section —
# looker_fetch.py reads that if this env file is absent.

# Your instance base URL. Modern Google-hosted Looker serves the API on 443 (no port):
#   https://<your-instance>.cloud.looker.com
# Older self-hosted instances used the legacy :19999 API port; include it only if that's yours.
LOOKER_BASE_URL=https://your-instance.cloud.looker.com

LOOKER_CLIENT_ID=your_api3_client_id
LOOKER_CLIENT_SECRET=your_api3_client_secret

# Leave true. Setting false disables TLS verification (not recommended).
LOOKER_VERIFY_SSL=true
